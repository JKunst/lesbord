[Unit]
Description=Lesbord (digitaal lesbord)
After=network.target

[Service]
User=streamlit
WorkingDirectory=/opt/lesbord
# Wachtwoord vóór het lesbord (standaard 'lesbord'); zet hier iets sterks:
Environment=LESBORD_WACHTWOORD=verander-mij
ExecStart=/opt/lesbord/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8600
Restart=always

[Install]
WantedBy=multi-user.target
